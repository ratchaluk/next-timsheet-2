# คัดลอกไฟล์นี้เป็น .env แล้วเติมค่าจริง (.env ถูก gitignore ไว้แล้ว)

# ── เว็บ timesheet ──
TIMESHEET_URL=https://timesheet.ntplc.co.th/

# ── Telegram ──
TELEGRAM_BOT_TOKEN=xxxxxxxx:yyyyyyyyyyyyyyyyyyyy
# รับคำสั่งเฉพาะ chat เหล่านี้ (คั่นด้วย comma)
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
# secret token ของ webhook — ไม่บังคับ แต่แนะนำให้ตั้ง (สุ่มอะไรก็ได้)
TELEGRAM_WEBHOOK_SECRET=

# ── รายชื่อผู้ใช้ (เรียงตามลำดับ user 1,2,3…) ──
# ลำดับใน command (/1-in-nm-B9) อ้างถึงเลข n ตรงนี้
USER_1_NAME=สมชาย
USER_1_USERNAME=somchai
USER_1_PASSWORD=secret1

USER_2_NAME=สมหญิง
USER_2_USERNAME=somying
USER_2_PASSWORD=secret2
# … เพิ่มได้ตามจำนวนคนในลิสต์

# ทางเลือก: ถ้าคนเยอะ ใช้ USERS_JSON แทน USER_n_* ได้ (ลำดับใน array เริ่มที่ 1)
# USERS_JSON=[{"name":"สมชาย","username":"somchai","password":"secret1"}]

# ── Playwright ──
HEADLESS=true            # true = ไม่เปิดหน้าต่างเบราว์เซอร์, false = เปิดให้เห็น (ใช้ debug selector)
NAV_TIMEOUT_MS=30000
SLOW_MO_MS=0             # หน่วงระหว่าง action (ms) — ตั้ง 300 ตอนนั่งดูว่าติดตรงไหน

# ── Server ──
PORT=3000
# URL สาธารณะของเครื่องนี้ — ใช้ ngrok: เติม URL ที่ได้จาก `ngrok http 3000`
# ตัวอย่าง: PUBLIC_URL=https://xxxx.ngrok-free.app (free เปลี่ยนทุกครั้งที่ restart)
PUBLIC_URL=
